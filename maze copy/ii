def _find_path(self) -> str:
    """Find path from entry to exit using DFS.

    Returns:
        Path string of N/E/S/W characters
    """
    start_r: int = self.entry[1]
    start_c: int = self.entry[0]
    goal_r: int  = self.exit_pos[1]
    goal_c: int  = self.exit_pos[0]

    visited: list[list[bool]] = [
        [False] * self.width
        for _ in range(self.height)
    ]

    # stack stores (row, col, path_so_far)
    # just like DFS but with path string added
    stack: list[tuple[int, int, str]] = \
        [(start_r, start_c, "")]
    visited[start_r][start_c] = True

    while stack:
        row, col, path = stack[-1]   # peek at top

        # check if reached goal
        if row, col == goal_r, goal_c:
            return path

        # find open unvisited neighbors
        found: bool = False
        for direction in ['N', 'E', 'S', 'W']:

            # wall must be OPEN
            if not self.maze[row][col]:
                dr, dc = MOVE[direction]
                nr = row + dr
                nc = col + dc

                if not visited[nr][nc]:
                    visited[nr][nc] = True
                    stack.append(
                        (nr, nc, path + direction)
                    )
                    found = True
                    break   # move forward immediately

        # no open unvisited neighbors → backtrack
        if not found:
            stack.pop()

    return ""

